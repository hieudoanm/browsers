{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "format": {
      "cache": true,
      "dependsOn": ["^format"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["out/**", "dist/**", "target/**"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test": {
      "cache": true,
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "dev": {
      "cache": true,
      "dependsOn": ["^dev"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
